{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contratos/meta.schema.json",
  "title": "meta.json: datos del campo alineado",
  "$comment": "ARCHIVO: contratos/meta.schema.json. ROL: fija la forma de meta.json: datos del campo alineado. PRODUCTOR: m2_alineacion/metadatos_campo.py. CONSUMIDORES: m3_deteccion, m7_publicacion, m9_sitio. RUTA REAL: datos/m2_alineacion/<campo>/meta.json, copiado a datos/m7_publicacion/<campo>/meta.json. VERIFICACION: check-jsonschema --schemafile contratos/meta.schema.json <archivo>. No contiene lógica: solo describe datos. AMPLIACION COMPATIBLE: origen y wcs opcionales.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_contrato",
    "campo",
    "nombre",
    "centro",
    "detector",
    "escala_segarc_por_pixel",
    "tamano_pixeles",
    "epocas",
    "horas_entre_a_b",
    "imagenes"
  ],
  "properties": {
    "_comentario": {
      "type": "string",
      "description": "Comentario libre para humanos. Ningún consumidor lo lee."
    },
    "version_contrato": {
      "const": "1",
      "description": "Versión del contrato. Cambia solo en un PR propio avisado a los cuatro lotes."
    },
    "campo": {
      "type": "string",
      "description": "Identificador del campo: minúsculas, cifras, guion bajo.",
      "pattern": "^[a-z0-9_]+$"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre legible del campo."
    },
    "centro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ra_grados",
        "dec_grados"
      ],
      "properties": {
        "ra_grados": {
          "type": "number",
          "description": "Ascensión recta ICRS en grados.",
          "minimum": 0,
          "maximum": 360
        },
        "dec_grados": {
          "type": "number",
          "description": "Declinación ICRS en grados.",
          "minimum": -90,
          "maximum": 90
        }
      },
      "description": "Centro del campo."
    },
    "detector": {
      "type": "integer",
      "description": "Detector de SPHEREx.",
      "minimum": 1,
      "maximum": 6
    },
    "escala_segarc_por_pixel": {
      "type": "number",
      "description": "Escala de la rejilla alineada. SPHEREx: 6,15.",
      "exclusiveMinimum": 0
    },
    "tamano_pixeles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ancho",
        "alto"
      ],
      "properties": {
        "ancho": {
          "type": "integer",
          "description": "Columnas de la rejilla alineada.",
          "minimum": 1
        },
        "alto": {
          "type": "integer",
          "description": "Filas de la rejilla alineada.",
          "minimum": 1
        }
      }
    },
    "epocas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoca_a",
        "epoca_b",
        "plantilla"
      ],
      "properties": {
        "epoca_a": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id_exposicion",
            "mjd"
          ],
          "properties": {
            "id_exposicion": {
              "type": "string",
              "description": "Exposición usada."
            },
            "mjd": {
              "type": "number",
              "description": "Fecha de la exposición en días julianos modificados (MJD)."
            }
          }
        },
        "epoca_b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id_exposicion",
            "mjd"
          ],
          "properties": {
            "id_exposicion": {
              "type": "string",
              "description": "Exposición usada."
            },
            "mjd": {
              "type": "number",
              "description": "Fecha de la exposición en días julianos modificados (MJD)."
            }
          }
        },
        "plantilla": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id_exposicion",
            "mjd"
          ],
          "properties": {
            "id_exposicion": {
              "type": "string",
              "description": "Exposición usada."
            },
            "mjd": {
              "type": "number",
              "description": "Fecha de la exposición en días julianos modificados (MJD)."
            }
          }
        }
      },
      "description": "Las tres imágenes del campo."
    },
    "horas_entre_a_b": {
      "type": "number",
      "description": "Horas de la época A a la época B.",
      "exclusiveMinimum": 0
    },
    "imagenes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoca_a",
        "epoca_b",
        "diferencia"
      ],
      "properties": {
        "epoca_a": {
          "const": "epoca_a.png"
        },
        "epoca_b": {
          "const": "epoca_b.png"
        },
        "diferencia": {
          "const": "diferencia.png"
        }
      },
      "description": "Nombres fijos de los PNG, relativos al directorio del campo."
    },
    "origen": {
      "description": "Procedencia de los datos: real (medido en SPHEREx), sintetico (generado para demostración o prueba) o pendiente (aún sin datos).",
      "enum": [
        "real",
        "sintetico",
        "pendiente"
      ]
    },
    "wcs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proyeccion",
        "crval_ra_grados",
        "crval_dec_grados",
        "crpix_x",
        "crpix_y",
        "cd"
      ],
      "description": "Solución WCS de la rejilla alineada, para convertir un clic (x, y) en RA/DEC. Si falta, la web no debe inventar coordenadas.",
      "properties": {
        "proyeccion": {
          "const": "TAN"
        },
        "crval_ra_grados": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "crval_dec_grados": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "crpix_x": {
          "type": "number",
          "description": "Píxel de referencia, base 0 como x en el resto de contratos (FITS CRPIX1 menos 1)."
        },
        "crpix_y": {
          "type": "number",
          "description": "Píxel de referencia, base 0 (FITS CRPIX2 menos 1)."
        },
        "cd": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "description": "Matriz CD [[cd11, cd12], [cd21, cd22]] en grados por píxel, con x hacia la derecha e y hacia arriba."
        }
      }
    }
  }
}
